{
  "name": "want-desyst",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "bun scripts/build.ts",
    "check": "tsc --noEmit && bun run --cwd apps/showcase check",
    "test": "bun test tests",
    "test:ui": "playwright test",
    "test:consumer": "bun scripts/check-consumer.ts",
    "dev": "bun run --cwd apps/showcase dev",
    "skill:install": "node packages/foundation/dist/install-skill.js",
    "flutter:tokens": "bun scripts/generate-flutter-tokens.ts",
    "flutter:check": "bun scripts/generate-flutter-tokens.ts --check && bun scripts/check-flutter-parity.ts && fvm flutter analyze packages/flutter",
    "flutter:test": "cd packages/flutter && fvm flutter test",
    "flutter:example": "cd packages/flutter/example && fvm flutter run",
    "flutter:consumer": "bun scripts/check-flutter-consumer.ts"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "@tailwindcss/vite": "^4",
    "tailwindcss": "^4",
    "typescript": "5.9.3",
    "vite": "6.4.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/bun": "^1.2.0",
    "@playwright/test": "1.63.0",
    "@axe-core/playwright": "4.13.0",
    "react": "^19",
    "react-dom": "^19"
  }
}

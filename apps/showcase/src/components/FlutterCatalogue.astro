---
import { copy, type Locale } from '../site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const c = copy[locale];
---
<div class="flutter-intro"><h1>Flutter · {c.catalogue}</h1><p>{c.flutterIntro}</p></div>
<div class="flutter-stage" data-flutter-stage data-state="loading" data-locale={locale}>
  <iframe data-flutter-frame title={`Flutter · ${c.catalogue}`} referrerpolicy="same-origin"></iframe>
  <div class="flutter-loading" role="status"><span class="flutter-loader" aria-hidden="true"></span><p>{c.loading}</p></div>
  <div class="flutter-error"><p role="alert">{c.failed}</p><button class="site-button primary" data-flutter-retry>{c.retry}</button><a data-flutter-standalone class="text-link" href={`/_flutter/?locale=${locale}`} target="_blank" rel="noopener">{c.standalone}</a></div>
</div>
<script>
  import { categoryOf, categories } from '../catalogue';
  const stage = document.querySelector<HTMLElement>('[data-flutter-stage]')!;
  const frame = stage.querySelector<HTMLIFrameElement>('iframe')!;
  let timeout: ReturnType<typeof setTimeout>;
  function settings() {
    const standalone = new URL('/_flutter/',location.origin);for(const [key,value] of Object.entries({locale:stage.dataset.locale!,theme:document.documentElement.dataset.theme!,direction:document.documentElement.dir,section:categoryOf(new URLSearchParams(location.search).get('section'))})) standalone.searchParams.set(key,value);stage.querySelector<HTMLAnchorElement>('[data-flutter-standalone]')!.href=standalone.href;
    frame.contentWindow?.postMessage({ type: 'want-allure:settings', theme: document.documentElement.dataset.theme, locale: stage.dataset.locale, direction:document.documentElement.dir, section:categoryOf(new URLSearchParams(location.search).get('section')) }, location.origin);
  }
  function armTimeout() {
    clearTimeout(timeout);
    timeout = setTimeout(() => { stage.dataset.state = 'error'; }, 45000);
  }
  function load() {
    clearTimeout(timeout); stage.dataset.state = 'loading';
    const url = new URL('/_flutter/', location.origin);
    url.searchParams.set('locale', stage.dataset.locale!);
    url.searchParams.set('theme', document.documentElement.dataset.theme ?? 'dark');
    url.searchParams.set('embedded', '1');
    url.searchParams.set('direction',document.documentElement.dir);
    url.searchParams.set('section',categoryOf(new URLSearchParams(location.search).get('section')));
    frame.src = url.href;
    armTimeout();
  }
  function message(event: MessageEvent) {
    if (event.origin !== location.origin || event.source !== frame.contentWindow) return;
    if (event.data?.type === 'want-allure:choose-theme' && (event.data.theme === 'light' || event.data.theme === 'dark')) dispatchEvent(new CustomEvent('want:choose-theme', { detail: event.data.theme }));
    if(event.data?.type==='want-allure:choose-section'&&categories.includes(event.data.section)) dispatchEvent(new CustomEvent('want:choose-section',{detail:event.data.section}));
    if(event.data?.type==='want-allure:choose-direction'&&(event.data.direction==='ltr'||event.data.direction==='rtl'))dispatchEvent(new CustomEvent('want:choose-direction',{detail:event.data.direction}));
    if (event.data?.type === 'want-allure:ready') { clearTimeout(timeout); settings(); stage.dataset.state = 'ready'; }
    if (event.data?.type === 'want-allure:error') { clearTimeout(timeout); stage.dataset.state = 'error'; }
  }
  addEventListener('message', message);
  for(const event of ['want:theme','want:direction','want:section']) addEventListener(event,settings);
  stage.querySelector('[data-flutter-retry]')!.addEventListener('click', load);
  window.addEventListener('pagehide', event => {
    clearTimeout(timeout);
    if (!event.persisted) { removeEventListener('message', message); for(const type of ['want:theme','want:direction','want:section']) removeEventListener(type,settings); }
  });
  window.addEventListener('pageshow', event => {
    if (!event.persisted) return;
    settings();
    if (stage.dataset.state === 'loading') armTimeout();
  });
  load();
</script>

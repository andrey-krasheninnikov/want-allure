---
import SiteLayout from '../../layouts/SiteLayout.astro';
import FlutterCatalogue from '../../components/FlutterCatalogue.astro';
import {locales,type Locale} from '../../site';

export function getStaticPaths() { return locales.filter(locale=>locale!=='en'&&locale!=='ru').map(locale=>({params:{locale},props:{locale}})); }
const {locale}=Astro.props as {locale:Locale};
---
<SiteLayout locale={locale} section="flutter" frame><FlutterCatalogue locale={locale} /></SiteLayout>
